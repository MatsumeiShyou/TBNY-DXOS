      "require_approval": false,
      "requires_sdr": false,
      "require_fact_in_commit": false,
      "require_minimal_trace": true
    },
    "T2": {
      "name": "Standard / 標準",
      "allow_unapproved_execution": true,
      "require_approval": false,
      "requires_sdr": false,
      "require_fact_in_commit": false,
      "require_regression_test": true
    },
    "T3": {
      "name": "Strict / 厳格",
      "allow_unapproved_execution": false,
      "require_approval": true,
      "requires_sdr": true,
      "approval_password": "y"
    }
  },
  "triage_rules": {
