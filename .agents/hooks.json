{
  "hook-observer": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-observer.js",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "write-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/write-safety-check.js",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "lint-check-on-write": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/post-write-check.js",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/safety-check.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
