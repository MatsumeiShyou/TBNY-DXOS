#!/usr/bin/env sh

# ルート衛生チェック: AI作業痕跡がステージングされていないか検査
DIRTY=$(git diff --cached --name-only | grep -E '^(fix_|fix\.|patch_|temp_|insert_|remove_|add_|make_|apply_|update_|old_|refactor\.|dom[0-9]*\.html)')
if [ -n "$DIRTY" ]; then
  echo ""
  echo "⛔ ルート衛生違反: 以下のファイルはルート直下にコミットできません。"
  echo "   scratch/ または scripts/ に移動してください。"
  echo ""
  echo "$DIRTY"
  echo ""
  exit 1
fi
