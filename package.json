{
  "name": "tbny-dxos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node start-all.js",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc -b",
    "request-done": "node .agent/scripts/request_done.js",
    "done": "(node scripts/sdr_validator.js --verify && npm run type-check && npm run integrity && node scripts/sdr_validator.js --commit && node .agent/scripts/closure_gate.js --reflect) || node .agent/scripts/safe_rollback.js",
    "integrity": "node .agent/scripts/integrity_check.js",
    "agent:scan": "node .agent/scripts/scan.js",
    "agent:stash": "node .agent/scripts/suspend.js",
    "agent:resume": "node .agent/scripts/resume.js",
    "agent:discard": "node .agent/scripts/discard.js",
    "agent:check": "node .agent/scripts/reflect.js --check",
    "agent:apply-patch": "node .agent/scripts/apply_patch.js",
    "agent:recover": "node .agent/scripts/recovery.js",
    "test": "vitest run",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@supabase/supabase-js": "^2.103.3",
    "acorn": "^8.16.0",
    "clsx": "^2.1.1",
    "esquery": "^1.7.0",
    "framer-motion": "^12.38.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "pg": "^8.20.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  }
}
